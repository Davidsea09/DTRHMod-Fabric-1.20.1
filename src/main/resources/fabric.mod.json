{
	"schemaVersion": 1,
	"id": "dtrhmod",
	"version": "${version}",
	"name": "Down The Rabbit Hole",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"EmanuelJDF09"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/dtrhmod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.emanueljdf09.dtrhmod.DownTheRabbitHole"
		],
		"client": [
			"net.emanueljdf09.dtrhmod.DownTheRabbitHoleClient"
		],
		"fabric-datagen": [
			"net.emanueljdf09.dtrhmod.DownTheRabbitHoleDataGenerator"
		],
		"cardinal-components-entity": [
			"net.emanueljdf09.dtrhmod.util.ModComponents"
		]

